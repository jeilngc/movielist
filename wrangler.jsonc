{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movielist",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Runs the "movie night reminder" push notification check once a day.
  // 13:00 UTC ≈ late morning/early afternoon across most timezones — adjust
  // to whenever you'd actually want a same-day nudge. Cron Triggers use UTC.
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "LIBRARY_KV",
      "id": "a88deffdd7f14aedbc0b965bbdbf3253"
    }
  ]
}
