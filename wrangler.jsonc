{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movielist",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Runs the "movie night reminder" push notification check once a day, at
  // 4:00 UTC, on the day a planned title is due. Cron Triggers use UTC —
  // adjust the hour if you'd rather the check (and reminder) land at a
  // different local time.
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "LIBRARY_KV",
      "id": "a88deffdd7f14aedbc0b965bbdbf3253"
    }
  ]
}
